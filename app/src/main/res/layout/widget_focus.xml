<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:id="@+id/card" style="@style/W.Card" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="32dp" android:orientation="vertical" android:gravity="center_vertical">
    <TextView android:id="@+id/focus_cap" style="@style/W.Cap" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <Chronometer android:id="@+id/focus_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:textSize="40sp" android:textColor="@color/ivory" android:includeFontPadding="false" />
    <TextView android:id="@+id/focus_subject" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:textStyle="italic" android:textSize="14sp" android:textColor="@color/ivory_soft" android:maxLines="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
      <TextView android:id="@+id/focus_main" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="108dp" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:background="@drawable/pill_gold" android:fontFamily="serif" android:textSize="15sp" android:textColor="@color/ivory" />
      <TextView android:id="@+id/focus_reset" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="10dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/pill_soft" android:fontFamily="serif" android:textSize="15sp" android:textColor="@color/ivory_soft" android:text="Sıfırla" />
    </LinearLayout>
  </LinearLayout>
  <ImageView android:id="@+id/focus_bird" android:layout_width="wrap_content" android:layout_height="56dp" android:layout_gravity="top|end" android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/w_greenbird" android:importantForAccessibility="no" />
</FrameLayout>
