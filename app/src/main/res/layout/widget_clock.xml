<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:orientation="vertical">
    <TextClock android:id="@+id/clock_date" style="@style/W.Cap" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="EEEE · d MMMM" android:format24Hour="EEEE · d MMMM" android:textColor="@color/gold" />
    <TextClock android:id="@+id/clock_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="h:mm" android:format24Hour="HH:mm" android:fontFamily="serif" android:textSize="84sp"
        android:includeFontPadding="false" android:letterSpacing="-0.02" android:textColor="@color/ivory" android:shadowColor="#99000000" android:shadowRadius="8" android:shadowDy="2" />
    <TextView android:id="@+id/clock_note" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="serif" android:textStyle="italic"
        android:textSize="16sp" android:textColor="@color/ivory_soft" android:text="Academia OS" />
  </LinearLayout>
  <ImageView android:id="@+id/clock_bird" android:layout_width="wrap_content" android:layout_height="64dp" android:layout_gravity="top|end" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/w_lory" android:importantForAccessibility="no" />
  <ImageView android:layout_width="wrap_content" android:layout_height="22dp" android:layout_gravity="bottom|end" android:layout_marginEnd="64dp" android:layout_marginBottom="18dp" android:adjustViewBounds="true" android:src="@drawable/w_bf_yellow" android:rotation="-14" android:importantForAccessibility="no" />
</FrameLayout>
